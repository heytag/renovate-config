{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "dependencyDashboard": true,
  "schedule": ["at any time"],
  "internalChecksFilter": "none",
  "labels": ["dependencies"],
  "platformAutomerge": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned versions in workflow/action files annotated with renovate comments",
      "managerFilePatterns": ["/.github/workflows/.*\\.yml$/", "/(^|/)action\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+\\w+:\\s*(?<currentValue>[^\\s]+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update pinned release downloads in Dockerfiles annotated with renovate comments",
      "managerFilePatterns": ["/(^|/)Dockerfile[^/]*$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+ADD --chmod=\\d+ https://github\\.com/[^/\\s]+/[^/\\s]+/releases/download/(?<currentValue>[^/\\s]+)/[^\\s]+"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update heytag/renovate-config version pin in extends",
      "managerFilePatterns": ["/^renovate\\.json5?$/", "/^\\.github/renovate\\.json5?$/"],
      "matchStrings": [
        "\"github>heytag/renovate-config#(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "heytag/renovate-config",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?:renovate-config-)?v?(?<version>[\\d].+)$"
    }
  ],
  "packageRules": [
    {
      "description": "All managers, patch updates: auto-merge after 3 days — per-repo can override with automerge: false for risky packages",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Safe managers, minor updates: auto-merge after 3 days",
      "matchManagers": ["gomod", "github-actions", "custom.regex", "bun", "docker-compose"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": ["gomod", "github-actions", "custom.regex", "bun", "docker-compose"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "manual-review"]
    },
    {
      "description": "Never automerge core framework and auth — always review",
      "matchPackageNames": ["next", "react", "react-dom", "@auth/core", "better-auth"],
      "automerge": false,
      "labels": ["dependencies", "manual-review"]
    },
    {
      "description": "sGTM Google Cloud Tagging image: update immediately, not just Monday",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["gcr.io/cloud-tagging-10302018/gtm-cloud-image"],
      "schedule": ["at any time"]
    },
    {
      "description": "Ignore internal heytag base images on STACKIT registry — not publicly accessible by Renovate",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^heytag\\/(bun-next-base|caddy-next-base)/"],
      "enabled": false
    },
    {
      "description": "trivy-action: custom.regex manager handles updates via github-releases; suppress conflicting github-actions manager lookup that fails with no-result",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["aquasecurity/trivy-action"],
      "enabled": false
    }
  ]
}
